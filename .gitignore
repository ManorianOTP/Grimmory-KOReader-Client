# Editor / IDE
.vscode/
.idea/
*.swp
*~

# OS cruft
.DS_Store
Thumbs.db

# Personal shell / tool configs that sometimes live in the work tree
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.ripgreprc

# Local MCP / tooling config
.mcp.json

# Local credentials and captured diagnostics
.env
.env.*
!.env.example
*.log
*.har
*.pcap
*.pcapng
*.sqlite
*.sqlite3

# Test harness local artifacts (see tests/.gitignore for fixtures/recorded)
tests/.busted-cache/
__pycache__/
*.py[cod]
node_modules/
coverage/
playwright-report/
test-results/

# Release build staging produced by scripts/release.sh
/build/
/dist/
*.koplugin.tar.gz
*.sha256

# Local-only licensed EPUB fixtures and derived samples. These must never be
# committed; CI uses the copyright-safe synthetic counterparts instead.
/tests/fixtures/recorded/
/tests/fixtures/private/

# Private provider refresh plans/evidence. Normal tests replay the ignored cache.
/tests/compatibility/private/
*.metadata-refresh-plan.json
*.metadata-selection-evidence.json
