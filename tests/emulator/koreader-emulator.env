# Pinned KOReader desktop runtime used by the Grimmory visual test harness.
#
# v2026.03 resolves to commit 825b9bced0eb666b45af4208e1c0095b88d38b0d.
# The archive and digest are from KOReader's official GitHub release.
KOREADER_VERSION="v2026.03"
KOREADER_COMMIT="825b9bced0eb666b45af4208e1c0095b88d38b0d"
KOREADER_ARCHIVE="koreader-linux-x86_64-v2026.03.tar.xz"
KOREADER_ARCHIVE_URL="https://github.com/koreader/koreader/releases/download/v2026.03/koreader-linux-x86_64-v2026.03.tar.xz"
KOREADER_ARCHIVE_SHA256="2fe4e5bb7973e30e3a3932f9370b549d6cc26272acaba471c35ebcaf81c741af"

# Paperwhite-class 300-DPI screen. The runner swaps width and height for its
# landscape pass while keeping the same DPI.
KOREADER_SCREEN_WIDTH="1072"
KOREADER_SCREEN_HEIGHT="1448"
KOREADER_SCREEN_DPI="300"

# Stable process environment. Visual scenarios deliberately do not render a
# live clock; UTC also makes any incidental date formatting consistent.
KOREADER_LOCALE="C.UTF-8"
KOREADER_TIMEZONE="UTC"
